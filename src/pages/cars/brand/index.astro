---
import Layout from "../../../layouts/Layout.astro";
import cars from "../../../assets/cars.json";

// Extraire la marque (premier mot de la propriété "name")
const brandList = [
  ...new Set(
    cars
      .map((c: any) => (c.name ? c.name.split(" ")[0] : null))
      .filter(Boolean)
  ),
].sort();
---

<Layout>
  <main class="p-8">
    <h1 class="text-2xl font-bold mb-6">Bonus : Liste des Marques de Voitures</h1>
    <ul class="list-disc pl-6 space-y-2">
      {
        brandList.map((brand) => (
          <li>
            <a
              href={`/cars/brand/${brand}/`}
              class="text-blue-600 hover:underline font-medium text-lg"
            >
              Voir le graphique pour la marque : {brand}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>