---
import Layout from "../../../layouts/Layout.astro";
import penguins from "../../../assets/penguins.json";

// Filtrer pour retirer les valeurs nulles/vides éventuelles
const sexList = [...new Set(penguins.map((p) => p.sex).filter(Boolean))];
---

<Layout>
  <main class="p-8">
    <h1 class="text-2xl font-bold mb-6">Liste par Sexe</h1>
    <ul class="list-disc pl-6 space-y-2">
      {
        sexList.map((sex) => (
          <li>
            <a
              href={`/penguins/sex/${sex}/`}
              class="text-blue-600 hover:underline font-medium text-lg"
            >
              Voir les manchots de sexe : {sex}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>