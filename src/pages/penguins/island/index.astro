---
import Layout from "../../../layouts/Layout.astro";
import penguins from "../../../assets/penguins.json";

const islandList = [...new Set(penguins.map((p) => p.island))];
---

<Layout>
  <main class="p-8">
    <h1 class="text-2xl font-bold mb-6">Liste des Îles</h1>
    <ul class="list-disc pl-6 space-y-2">
      {
        islandList.map((island) => (
          <li>
            <a
              href={`/penguins/island/${island}/`}
              class="text-blue-600 hover:underline font-medium text-lg"
            >
              Voir les manchots sur l'île : {island}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>