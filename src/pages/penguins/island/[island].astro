---
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../../assets/penguins.json";

export function getStaticPaths() {
  const islandList = [...new Set(penguins.map((p) => p.island))];
  return islandList.map((island) => ({
    params: { island },
  }));
}

const { island } = Astro.params;
const filteredPenguins = penguins.filter((p) => p.island === island);
---

<Layout>
  <main class="p-8">
    <a href="/penguins/island" class="text-blue-500 hover:underline mb-4 inline-block">
      ← Retour à la liste des îles
    </a>
    <h1 class="text-2xl font-bold mb-6">Île : {island}</h1>

    <div class="border p-4 rounded-lg bg-gray-50">
      <PlotFigure
        options={{
          title: `Graphique - Île ${island}`,
          marks: [
            Plot.dot(filteredPenguins, {
              x: "culmen_length_mm",
              y: "culmen_depth_mm",
              stroke: "species",
            }),
          ],
        }}
      />
    </div>
  </main>
</Layout>